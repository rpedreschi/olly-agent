{
  "mcpServers": {
    "deltastream": {
      "command": "npx",
      "args": [
        "-y",
        "@deltastream/mcp-server"
      ],
      "env": {
        "DELTASTREAM_API_URL": "https://api.deltastream.io/mcp/v1",
        "DELTASTREAM_TOKEN": "<YOUR_DELTASTREAM_API_TOKEN>",
        "DELTASTREAM_DATABASE": "<YOUR_DATABASE_NAME>",
        "DELTASTREAM_SCHEMA": "<YOUR_SCHEMA_NAME>",

        "DELTASTREAM_RELATIONS": "oci_audit_mv,oci_logging_mv,agent_actions_mv"
      }
    },

    "suspend-principal": {
      "command": "node",
      "args": [
        "suspend_principal_mcp/index.js"
      ],
      "env": {
        "KAFKA_BOOTSTRAP":      "<OCI_KAFKA_BOOTSTRAP>",
        "KAFKA_SASL_USERNAME":  "<OCI_KAFKA_USERNAME>",
        "KAFKA_SASL_PASSWORD":  "<OCI_KAFKA_PASSWORD>",
        "AGENT_ACTIONS_TOPIC":  "mcp_agent_actions",

        "MOCK_OCI_FUNCTION": "true",

        "OCI_SUSPEND_FUNCTION_ENDPOINT": "<YOUR_OCI_FUNCTION_ENDPOINT>",
        "OCI_FUNCTION_AUTH_TOKEN": "<YOUR_OCI_FUNCTION_AUTH_TOKEN>"
      }
    }
  }
}
